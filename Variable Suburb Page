	<h1>/Suburb Name [Variable]/</h1>
	
	<script>
	const pages = {
	  "Home": "https://eyk0001.github.io/Income-vs-Housing-Market/Income%20vs%20housing%20market.html",
	  "Price Growth vs Wage Growth": "https://eyk0001.github.io/Income-vs-Housing-Market/Price%20Growth%20vs%20Wage%20Growth.html",
	  "Can You Afford to Live Here": "https://eyk0001.github.io/Income-vs-Housing-Market/Can%20You%20Afford%20to%20Live%20Here.html",
	  "subpage4": "subpage4.html"
	};
	
	const searchInput = document.getElementById("navSearch");
	const resultsBox = document.getElementById("searchResults");

	searchInput.addEventListener("input", () => {
	  const query = searchInput.value.toLowerCase();
	  resultsBox.innerHTML = "";

	  if (!query) {
		resultsBox.style.display = "none";
		return;
	  }

	  Object.keys(pages).forEach(page => {
		if (page.toLowerCase().includes(query)) {
		  const item = document.createElement("div");
		  item.className = "resultItem";
		  item.textContent = page;

		  item.onclick = () => {
			window.location.href = pages[page];
		  };

		  resultsBox.appendChild(item);
		}
	  });

	  resultsBox.style.display = "block";
	});

	document.addEventListener("click", (e) => {
	  if (!e.target.closest(".search-box")) {
		resultsBox.style.display = "none";
	  }
	});
	function updateClock() {
	  const now = new Date();

	  const hours = String(now.getHours()).padStart(2, '0');
	  const minutes = String(now.getMinutes()).padStart(2, '0');
	  const seconds = String(now.getSeconds()).padStart(2, '0');

	  document.getElementById("clock").textContent =
		`${hours}:${minutes}:${seconds}`;
	}

	setInterval(updateClock, 1000);
	updateClock();

</script>


<label>Select Suburbs (Ctrl/Cmd + Click):</label><br>
<select id="suburbSelect" multiple size="8" style="width:300px;"></select>

<canvas id="myChart"></canvas>

<script>
let chart;

d3.csv("medHousePrice.csv").then(function(data) {

    const columns = data.columns;
    const quarters = columns.slice(1);
    const select = document.getElementById("suburbSelect");

    // Populate dropdown
    data.forEach(row => {
        const option = document.createElement("option");
        option.value = row.Suburb;
        option.textContent = row.Suburb;
        select.appendChild(option);
    });

    // Create empty chart initially
    chart = new Chart(document.getElementById("myChart"), {
        type: "line",
        data: {
            labels: quarters,
            datasets: []
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    display: true,
                    position: "right"
                }
            },
            scales: {
                y: {
                    ticks: {
                        callback: function(value) {
                            return "$" + value.toLocaleString();
                        }
                    }
                }
            }
        }
    });

    // Update chart when selection changes
    select.addEventListener("change", function() {

        const selectedSuburbs = Array.from(this.selectedOptions)
                                     .map(option => option.value);

        const newDatasets = selectedSuburbs.map((suburb, index) => {
            const row = data.find(d => d.Suburb === suburb);

            return {
                label: suburb,
                data: quarters.map(q => +row[q]),
                borderColor: getColor(index),
                backgroundColor: getColor(index),
                fill: false,
                tension: 0.2
            };
        });

        chart.data.datasets = newDatasets;
        chart.update();
    });

});

// Generate distinct colours using golden angle
function getColor(index) {
    const hue = (index * 137.5) % 360;
    return `hsl(${hue}, 70%, 50%)`;
}
</script>

